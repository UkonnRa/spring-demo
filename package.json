{
  "name": "white-rabbit",
  "packageManager": "yarn@4.2.2",
  "version": "0.1.0",
  "engines": {
    "yarn": ">=4",
    "node": ">=20"
  },
  "private": true,
  "workspaces": [
    "packages/frontend-core",
    "packages/app-desktop"
  ],
  "devDependencies": {
    "@commitlint/cli": "19.3.0",
    "@commitlint/config-conventional": "19.2.2",
    "@eslint/js": "^9.6.0",
    "@intlify/unplugin-vue-i18n": "^4.0.0",
    "@quasar/vite-plugin": "^1.7.0",
    "@types/eslint": "^8.56.10",
    "@types/jsdom": "^21.1.7",
    "@types/lodash": "^4.17.6",
    "@types/node": "^20.14.10",
    "@vitejs/plugin-vue": "^5.0.5",
    "@vitest/coverage-v8": "^1.6.0",
    "@vue/compiler-dom": "^3.4.31",
    "@vue/test-utils": "^2.4.6",
    "@vue/tsconfig": "^0.5.1",
    "autoprefixer": "^10.4.19",
    "commitizen": "^4.3.0",
    "commitlint": "19.3.0",
    "cross-env": "^7.0.3",
    "cz-conventional-changelog": "^3.3.0",
    "eslint": "^9.6.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-vue": "^9.27.0",
    "husky": "^9.0.11",
    "jsdom": "^24.1.0",
    "markdownlint-cli": "^0.41.0",
    "postcss": "^8.4.39",
    "postcss-html": "^1.7.0",
    "postcss-load-config": "^6.0.1",
    "prettier": "^3.3.2",
    "rimraf": "^5.0.8",
    "rollup-plugin-visualizer": "^5.12.0",
    "sass": "^1.77.6",
    "sass-loader": "^14.2.1",
    "stylelint": "^16.6.1",
    "stylelint-config-recommended-scss": "^14.0.0",
    "stylelint-config-recommended-vue": "^1.5.0",
    "stylelint-config-standard-scss": "^13.1.0",
    "stylelint-config-standard-vue": "^1.0.0",
    "tailwindcss": "^3.4.4",
    "typescript": "^5.5.3",
    "typescript-eslint": "^7.15.0",
    "vite": "^5.3.3",
    "vitest": "^1.6.0",
    "vue": "^3.4.31",
    "vue-eslint-parser": "^9.4.3",
    "vue-tsc": "^2.0.26"
  },
  "scripts": {
    "postinstall": "husky",
    "build": "yarn build:java && yarn build:js",
    "build:js": "yarn workspaces foreach --from 'packages/*' -Rpitv run build",
    "build:java": "./gradlew nativeCompile",
    "lint": "yarn lint:prettier && yarn lint:stylelint && yarn lint:java && yarn lint:js",
    "lint:prettier": "yarn lint:base:prettier --check",
    "lint:stylelint": "stylelint '**/*.{vue,scss,css}' --ignore-path .prettierignore",
    "lint:java": "./gradlew check -x test",
    "lint:js": "yarn workspaces foreach --from 'packages/*' -Rpitv run lint",
    "lint:fix": "yarn lint:fix:prettier && yarn lint:fix:stylelint && yarn lint:fix:java && yarn lint:fix:js",
    "lint:fix:prettier": "yarn lint:base:prettier --write",
    "lint:fix:stylelint": "yarn lint:stylelint --fix",
    "lint:fix:java": "./gradlew spotlessApply",
    "lint:fix:js": "yarn workspaces foreach --from 'packages/*' -Rpitv run lint:fix",
    "lint:base:prettier": "prettier '**/*.{vue,ts,js,mjs,json}'",
    "upgrade": "yarn upgrade-interactive && ./gradlew dependencyUpdates",
    "test": "yarn test:java && yarn test:js",
    "test:java": "./gradlew test nativeTest",
    "test:js": "yarn workspaces foreach --from 'packages/*' -Rpitv run test"
  },
  "config": {
    "commitizen": {
      "path": "./node_modules/cz-conventional-changelog"
    }
  }
}
